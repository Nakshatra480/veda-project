# ──────────────────────────────────────────────────
# VedaAI Environment Variables
# ──────────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vedaai?retryWrites=true&w=majority

# Redis (Upstash or Railway)
REDIS_URL=rediss://default:<password>@<host>:<port>

# OpenRouter LLM API Key
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=minimax/minimax-m2.5

# API Server port (Koyeb auto-assigns via $PORT)
PORT=4000

# CORS: Your Vercel frontend URL (comma-separated for multiple)
CORS_ORIGIN=https://your-app.vercel.app

# ──── Frontend (Next.js) ────
# The deployed Koyeb API URL
NEXT_PUBLIC_API_URL=https://your-api.koyeb.app
NEXT_PUBLIC_WS_URL=https://your-api.koyeb.app
